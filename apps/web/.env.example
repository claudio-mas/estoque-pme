# Sem DATABASE_URL, o app usa PGlite persistido em DADOS_PGLITE (padrão: ./.dados).
# Em produção, DATABASE_URL é a string do papel `aplicacao` — nunca a do dono.
DATABASE_URL=
DADOS_PGLITE=.dados

# Auth.js. Gere com: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Sem SMTP_URL, o link de acesso sai no terminal (só desenvolvimento).
SMTP_URL=
EMAIL_DE="Estoque PME <nao-responda@localhost>"
